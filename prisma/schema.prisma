// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // Optional for OAuth users
  avatar    String?
  
  // OAuth fields
  provider     String?  // 'google', 'github', etc.
  providerId   String?
  
  // Profile & Gamification
  totalXP      Int      @default(0)
  level        Int      @default(1)
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  
  // Preferences
  preferences  Json     @default("{}")
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
  
  // Relations
  sessions         Session[]
  progress         UserProgress[]
  quizAttempts     QuizAttempt[]
  cardReviews      CardReview[]
  achievements     UserAchievement[]
  learningSessions LearningSession[]
  tutorSessions    TutorSession[]
  
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

// ============================================================================
// COURSE STRUCTURE & CONTENT
// ============================================================================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  version     String   @default("1.0.0")
  slug        String   @unique
  
  // Course settings
  settings    Json     @default("{}")
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  modules     Module[]
  
  @@map("courses")
}

model Module {
  id               String @id @default(cuid())
  courseId         String
  title            String
  slug             String
  description      String?
  order            Int
  estimatedDuration Int   @default(0) // in minutes
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relations
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  
  @@unique([courseId, slug])
  @@map("modules")
}

model Lesson {
  id               String @id @default(cuid())
  moduleId         String
  title            String
  slug             String
  content          String // Original markdown content
  htmlContent      String // Processed HTML content
  frontmatter      Json   @default("{}")
  order            Int
  estimatedReadTime Int   @default(0) // in minutes
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relations
  module           Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assets           Asset[]
  terms            Term[]
  objectives       LearningObjective[]
  progress         UserProgress[]
  quizzes          Quiz[]
  cards            Card[]
  crossReferences  CrossReference[]
  
  @@unique([moduleId, slug])
  @@map("lessons")
}

model Asset {
  id        String @id @default(cuid())
  lessonId  String
  filename  String
  path      String
  url       String?
  type      String // 'image', 'video', 'audio', 'document'
  size      Int?
  metadata  Json   @default("{}")
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@map("assets")
}

model CrossReference {
  id         String @id @default(cuid())
  fromLessonId String
  toLessonId   String
  anchor     String?
  context    String?
  
  // Relations
  fromLesson Lesson @relation(fields: [fromLessonId], references: [id], onDelete: Cascade)
  
  @@map("cross_references")
}

// ============================================================================
// AWS-SPECIFIC ENTITIES
// ============================================================================

model AWSService {
  id            String   @id @default(cuid())
  name          String   @unique
  fullName      String?
  category      String
  description   String
  useCases      String[]
  pricingModel  String?
  features      String[]
  limitations   String[]
  relatedServices String[]
  
  // Metadata
  officialDocs  String?
  iconUrl       String?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  scenarios     AWSScenario[]
  terms         Term[]
  
  @@map("aws_services")
}

model AWSScenario {
  id              String @id @default(cuid())
  title           String
  description     String
  businessContext String
  difficulty      Difficulty
  services        String[]
  
  // Solution details
  solution        String?
  alternatives    String[]
  tradeoffs       Json   @default("{}")
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  awsServices     AWSService[]
  questions       Question[]
  
  @@map("aws_scenarios")
}

// ============================================================================
// KNOWLEDGE EXTRACTION & TERMINOLOGY
// ============================================================================

model Term {
  id           String     @id @default(cuid())
  term         String
  definition   String
  category     TermCategory
  sourceAnchor String?
  context      String?
  
  // AWS-specific fields
  awsServiceId String?
  lessonId     String?
  
  // Metadata
  difficulty   Difficulty @default(BEGINNER)
  frequency    Int        @default(0)
  
  // Timestamps
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  // Relations
  awsService   AWSService? @relation(fields: [awsServiceId], references: [id])
  lesson       Lesson?     @relation(fields: [lessonId], references: [id])
  relatedTerms TermRelation[] @relation("TermRelations")
  cards        Card[]
  
  @@unique([term, category])
  @@map("terms")
}

model TermRelation {
  id           String       @id @default(cuid())
  fromTermId   String
  toTermId     String
  relationship RelationType
  
  // Relations
  fromTerm     Term @relation("TermRelations", fields: [fromTermId], references: [id], onDelete: Cascade)
  
  @@unique([fromTermId, toTermId, relationship])
  @@map("term_relations")
}

model LearningObjective {
  id          String @id @default(cuid())
  lessonId    String
  objective   String
  category    String
  difficulty  Difficulty @default(BEGINNER)
  
  // Bloom's taxonomy level
  bloomLevel  BloomLevel @default(REMEMBER)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@map("learning_objectives")
}

// ============================================================================
// QUIZ & ASSESSMENT SYSTEM
// ============================================================================

model Quiz {
  id          String @id @default(cuid())
  lessonId    String?
  title       String
  description String?
  difficulty  Difficulty @default(BEGINNER)
  timeLimit   Int?       // in minutes
  
  // Quiz settings
  shuffleQuestions Boolean @default(true)
  shuffleChoices   Boolean @default(true)
  showFeedback     Boolean @default(true)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  lesson      Lesson?      @relation(fields: [lessonId], references: [id])
  questions   Question[]
  attempts    QuizAttempt[]
  
  @@map("quizzes")
}

model Question {
  id            String       @id @default(cuid())
  quizId        String?
  scenarioId    String?
  type          QuestionType
  stem          String
  difficulty    Difficulty   @default(BEGINNER)
  
  // Question content
  choices       Json?        // For MCQ: array of choice objects
  correctAnswer Json         // Flexible format for different question types
  rationale     String
  
  // AWS context
  awsServices   String[]
  sourceAnchors String[]
  
  // Metadata
  bloomLevel    BloomLevel   @default(REMEMBER)
  estimatedTime Int          @default(60) // in seconds
  
  // Timestamps
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Relations
  quiz          Quiz?        @relation(fields: [quizId], references: [id])
  scenario      AWSScenario? @relation(fields: [scenarioId], references: [id])
  answers       Answer[]
  
  @@map("questions")
}

model QuizAttempt {
  id          String @id @default(cuid())
  userId      String
  quizId      String
  score       Float
  maxScore    Float
  timeSpent   Int    // in seconds
  
  // Attempt metadata
  startedAt   DateTime
  completedAt DateTime?
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     Answer[]
  
  @@map("quiz_attempts")
}

model Answer {
  id           String @id @default(cuid())
  attemptId    String
  questionId   String
  userAnswer   Json
  isCorrect    Boolean
  timeSpent    Int    @default(0) // in seconds
  confidence   Int?   // 1-5 scale
  
  // Timestamps
  answeredAt   DateTime @default(now())
  
  // Relations
  attempt      QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([attemptId, questionId])
  @@map("answers")
}

// ============================================================================
// SPACED REPETITION SYSTEM
// ============================================================================

model Card {
  id          String   @id @default(cuid())
  termId      String?
  lessonId    String?
  type        CardType
  
  // Card content
  front       String
  back        String
  hint        String?
  
  // SRS algorithm data
  interval    Int      @default(1)
  easeFactor  Float    @default(2.5)
  repetitions Int      @default(0)
  nextReview  DateTime @default(now())
  
  // Card metadata
  difficulty  Difficulty @default(BEGINNER)
  tags        String[]
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  term        Term?       @relation(fields: [termId], references: [id])
  lesson      Lesson?     @relation(fields: [lessonId], references: [id])
  reviews     CardReview[]
  
  @@map("cards")
}

model CardReview {
  id         String @id @default(cuid())
  userId     String
  cardId     String
  ease       Int    // 1-4 scale (Again, Hard, Good, Easy)
  timeSpent  Int    // in seconds
  confidence Int?   // 1-5 scale
  
  // SRS algorithm used
  algorithm  String @default("SM2")
  
  // Timestamps
  reviewedAt DateTime @default(now())
  
  // Relations
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  @@map("card_reviews")
}

// ============================================================================
// PROGRESS TRACKING & ANALYTICS
// ============================================================================

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  timeSpent   Int            @default(0) // in seconds
  confidence  Int            @default(3) // 1-5 scale
  
  // Progress metadata
  startedAt   DateTime?
  completedAt DateTime?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([userId, lessonId])
  @@map("user_progress")
}

model LearningSession {
  id         String @id @default(cuid())
  userId     String
  startTime  DateTime
  endTime    DateTime?
  xpEarned   Int      @default(0)
  
  // Session metadata
  activities Json     @default("[]")
  
  // Relations
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("learning_sessions")
}

// ============================================================================
// GAMIFICATION & ACHIEVEMENTS
// ============================================================================

model Achievement {
  id          String @id @default(cuid())
  title       String @unique
  description String
  icon        String
  category    AchievementCategory
  
  // Achievement criteria
  criteria    Json
  xpReward    Int  @default(0)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       UserAchievement[]
  
  @@map("achievements")
}

model UserAchievement {
  id            String @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  
  // Relations
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ============================================================================
// AI TUTORING SYSTEM
// ============================================================================

model TutorSession {
  id        String @id @default(cuid())
  userId    String
  mode      TutorMode @default(ANSWER)
  
  // Session context
  lessonId  String?
  topic     String?
  
  // Timestamps
  startedAt DateTime @default(now())
  endedAt   DateTime?
  
  // Relations
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TutorMessage[]
  
  @@map("tutor_sessions")
}

model TutorMessage {
  id        String @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  
  // Message metadata
  citations Json @default("[]")
  confidence Float?
  
  // Timestamps
  createdAt DateTime @default(now())
  
  // Relations
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@map("tutor_messages")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum TermCategory {
  AWS_SERVICE
  AI_CONCEPT
  TECHNICAL_TERM
  BUSINESS_CONCEPT
  CERTIFICATION_TERM
}

enum RelationType {
  RELATED_TO
  PART_OF
  DEPENDS_ON
  SIMILAR_TO
  OPPOSITE_OF
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum QuestionType {
  MULTIPLE_CHOICE
  CLOZE_DELETION
  SCENARIO_BASED
  IMAGE_OCCLUSION
  TRUE_FALSE
}

enum CardType {
  BASIC
  CLOZE
  IMAGE_OCCLUSION
  REVERSE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

enum AchievementCategory {
  LEARNING
  CONSISTENCY
  MASTERY
  SOCIAL
  MILESTONE
}

enum TutorMode {
  ANSWER
  SOCRATIC
  DRILL
  EXPLAIN
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}